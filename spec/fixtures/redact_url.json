    "options": {
      "secret_names": [
        "token"
      ]
    }
  },
  {
    "name": "userinfo password containing a fragment delimiter",
    "input": "postgres://u:p#LEAK@h/db",
    "expected": "postgres://u:***@h/db"
  },
  {
    "name": "userinfo password containing a query delimiter",
