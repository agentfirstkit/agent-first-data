      "url": "https://example.test/a?b=1&c=<2>"
    },
    "expected_json_text": "{\"l\":[{\"k\":\"x&y\u2028\"}],\"s\":\"a\u2028b\u2029c\",\"url\":\"https://example.test/a?b=1&c=<2>\"}",
    "expected_yaml": "---\nl:\n  -\n    k: \"x&y\u2028\"\ns: \"a\u2028b\u2029c\"\nurl: \"https://example.test/a?b=1&c=<2>\"",
    "expected_plain": "l=\"{\\\"k\\\":\\\"x&y\u2028\\\"}\" s=a\u2028b\u2029c url=\"https://example.test/a?b=1&c=<2>\""
  },
  {
    "name": "native_numbers_nested_in_plain_arrays_use_the_canonical_number_form",
    "description": "Each SDK parses this input natively. Number leaves of a container nested in an array take the canonical number form in Plain, exactly as YAML prints them. JSON keeps the sign of a native -0.",
    "input": {
      "m": [
        [
          100000.0,
          1.0,
          1e-06,
          1e+16,
          -0.0
        ]
      ],
      "o": [
        {
          "a": 6.022e+23,
          "b": 1.0,
          "c": 1e-07
        }
      ]
    },
    "expected_json": {
      "m": [
        [
          100000.0,
          1.0,
          1e-06,
          1e+16,
          -0.0
        ]
      ],
      "o": [
        {
          "a": 6.022e+23,
          "b": 1.0,
          "c": 1e-07
        }
      ]
    },
    "expected_yaml": "---\nm:\n  -\n    - 100000\n    - 1\n    - 0.000001\n    - 10000000000000000\n    - -0\no:\n  -\n    a: 6.022e+23\n    b: 1\n    c: 1e-7",
    "expected_plain": "m=[100000,1,0.000001,10000000000000000,-0] o=\"{\\\"a\\\":6.022e+23,\\\"b\\\":1,\\\"c\\\":1e-7}\""
  },
  {
    "name": "native_integral_floats_beyond_2_53_render_like_any_float",
    "description": "A JavaScript number of 2^53 or more is a float64 like every other SDK's native float, so it renders by the canonical number form rather than being refused: 1e21 reads 1e+21 and 2^53 reads its digits.",
    "input": {
      "big": 1e+21,
      "edge": 9007199254740992,
      "list": [
        1e+21,
        -1e+21
      ],
      "small": -1e+21
    },
    "expected_json": {
      "big": 1e+21,
      "edge": 9007199254740992,
      "list": [
        1e+21,
        -1e+21
      ],
      "small": -1e+21
    },
    "expected_yaml": "---\nbig: 1e+21\nedge: 9007199254740992\nlist:\n  - 1e+21\n  - -1e+21\nsmall: -1e+21",
    "expected_plain": "big=1e+21 edge=9007199254740992 list=1e+21,-1e+21 small=-1e+21"
  },
  {
    "name": "native_integral_floats_take_their_shortest_spelling_on_integer_suffixes",
    "description": "Integer-required suffixes read a native float through its shortest decimal spelling, the text the canonical number form prints, not its exact binary value. 2^60 as a float64 is spelled 1.152921504606847e+18, so it counts as 1152921504606847000 in every SDK, exactly as a decoded literal of that spelling does.",
    "input": {
      "fee_jpy": 1.152921504606847e+18,
      "price_usd_cents": 1.152921504606847e+18,
      "size_bytes": 1.152921504606847e+18
    },
    "expected_json": {
      "fee_jpy": 1.152921504606847e+18,
      "price_usd_cents": 1.152921504606847e+18,
      "size_bytes": 1.152921504606847e+18
    },
    "expected_yaml": "---\nfee_jpy: 1152921504606847000\nprice_usd_cents: 1152921504606847000\nsize_bytes: 1152921504606847000",
    "expected_plain": "fee=¥1,152,921,504,606,847,000 price=$11529215046068470.00 size=1048576.0TiB"
  },
  {
    "name": "ms_seconds_round_exact_ties_half_to_even",
    "input": {
      "a_ms": 1062.5,
      "b_ms": -3312.5
