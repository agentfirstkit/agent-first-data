  {
    "name": "native_float_notation_has_one_threshold",
    "description": "A fractional number renders positionally in [1e-6, 1e21) and in exponent form outside it, the thresholds of ECMAScript's Number#toString. Each runtime's own shortest formatter switches elsewhere (Go from 1e6 and below 1e-4, Python below 1e-4, Rust below 1e-5), so the SDK decides the notation on the digits.",
    "input": {
      "a": 1234567.5,
      "b": 0.000015,
      "c": 0.000001,
      "d": -2.5e-9,
      "e": 1.5e-22,
      "f": 123456.789
    },
    "expected_json": {
      "a": 1234567.5,
      "b": 0.000015,
      "c": 0.000001,
      "d": -2.5e-9,
      "e": 1.5e-22,
      "f": 123456.789
    },
    "expected_yaml": "---\na: 1234567.5\nb: 0.000015\nc: 0.000001\nd: -2.5e-9\ne: 1.5e-22\nf: 123456.789",
    "expected_plain": "a=1234567.5 b=0.000015 c=0.000001 d=-2.5e-9 e=1.5e-22 f=123456.789"
  },
